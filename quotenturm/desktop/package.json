{
  "name": "quotenturm",
  "productName": "Quotenturm",
  "version": "1.0.0",
  "description": "TV- & Streaming-Manager",
  "main": "main.js",
  "private": true,
  "scripts": {
    "prepare-app": "node prepare.js",
    "start": "npm run prepare-app && electron .",
    "dist": "npm run prepare-app && electron-builder --win portable nsis --publish never",
    "dist:portable": "npm run prepare-app && electron-builder --win portable --publish never"
  },
  "devDependencies": {
    "@fontsource/barlow-condensed": "^5.1.0",
    "@fontsource/inter": "^5.1.0",
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "xlsx": "^0.18.5"
  },
  "build": {
    "appId": "de.private.quotenturm",
    "productName": "Quotenturm",
    "files": [
      "main.js",
      "app/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "Quotenturm-${version}-portable.exe"
    },
    "nsis": {
      "artifactName": "Quotenturm-${version}-Setup.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Quotenturm"
    }
  },
  "repository": "github:dfertl18-rgb/New-Notetaker"
}
