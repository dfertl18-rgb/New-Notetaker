{
  "name": "quotenturm",
  "productName": "Medienmanager 2027",
  "version": "1.3.3",
  "description": "TV- & Streaming-Manager",
  "main": "main.js",
  "private": true,
  "scripts": {
    "prepare-app": "node prepare.js",
    "start": "npm run prepare-app && electron .",
    "dist": "npm run prepare-app && electron-builder --win portable nsis --publish never",
    "dist:portable": "npm run prepare-app && electron-builder --win portable --publish never",
    "dist:share": "npm run prepare-app:share && electron-builder --win portable nsis --publish never -c.portable.artifactName='Medienmanager-2027-${version}-Weitergabe-portable.exe' -c.nsis.artifactName='Medienmanager-2027-${version}-Weitergabe-Setup.exe'",
    "prepare-app:share": "node prepare.js --share"
  },
  "devDependencies": {
    "@fontsource/barlow-condensed": "^5.1.0",
    "@fontsource/inter": "^5.1.0",
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "resedit": "^2.0.3",
    "xlsx": "^0.18.5"
  },
  "build": {
    "appId": "de.private.quotenturm",
    "productName": "Medienmanager 2027",
    "files": [
      "main.js",
      "preload.js",
      "app/**/*",
      "!node_modules/@node-llama-cpp/linux-*/**",
      "!node_modules/@node-llama-cpp/mac-*/**",
      "!node_modules/@node-llama-cpp/win-arm64/**",
      "!node_modules/@node-llama-cpp/*cuda*/**",
      "!node_modules/node-llama-cpp/llama/**/*.c",
      "!node_modules/node-llama-cpp/llama/**/*.cpp"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "signAndEditExecutable": false,
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "Medienmanager-2027-${version}-portable.exe"
    },
    "nsis": {
      "artifactName": "Medienmanager-2027-${version}-Setup.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Medienmanager 2027",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "language": "1031",
      "installerLanguages": [
        "de_DE"
      ],
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    },
    "afterPack": "./afterpack.js",
    "asarUnpack": [
      "node_modules/node-llama-cpp/**",
      "node_modules/@node-llama-cpp/**"
    ],
    "extraResources": [
      {
        "from": "models",
        "to": "models",
        "filter": [
          "LICENSE*"
        ]
      }
    ]
  },
  "repository": "github:dfertl18-rgb/New-Notetaker",
  "dependencies": {
    "node-llama-cpp": "^3.22.1"
  }
}
